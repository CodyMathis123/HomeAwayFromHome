# EXAMPLE ONLY; keep existing .env HomeAway domain variables unchanged.
# These three new hostnames need publicly authoritative DNS-01 TXT responses,
# but no public A/AAAA records or new WAN forward.
HOMEAWAY_PUBLIC_HOME=home.homeawayfromhome.house
HOMEAWAY_PUBLIC_AUTH=auth.homeawayfromhome.house
HOMEAWAY_PUBLIC_METRICS=metrics.homeawayfromhome.house
