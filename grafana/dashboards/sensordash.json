{
  "id": null,
  "uid": "homeaway-sensordash",
  "title": "SensorDash · Hardware Telemetry",
  "tags": [
    "homeaway",
    "sensordash",
    "read-only",
    "hardware"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 11,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "editable": false,
  "graphTooltip": 1,
  "description": "Live Windows hardware readings. SensorDash remains responsible for fan control and cooling configuration. Display labels are resolved from a read-only catalog; numeric history and sensor identities are unchanged. Detailed per-sensor Windows telemetry for investigation; the Overview holds the short everyday summary.",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Windows computer",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homeaway-vm"
        },
        "query": {
          "query": "label_values(sensordash_reading_value,host)",
          "refId": "Host"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "sensor",
        "label": "Sensor · ID",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homeaway-vm"
        },
        "query": {
          "query": "label_values(sensordash_reading_value{host=~\"$host\"},sensor)",
          "refId": "Sensor"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "title": "Sensor reference · names and aliases",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "description": "Discoverable sensor catalog. This table is reference material, placed below the live charts. Technical IDs remain available in Grafana Explore.",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Alias"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "unassigned": {
                        "text": "—"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [],
        "content": "### HARDWARE OVERVIEW\nLatest temp = highest current/last-available physical reading; Range peak = highest observed reading over the selected Grafana time window. **The winning sensor is shown directly in each Stat card title**, using SensorDash aliases first and cleaned hardware names otherwise. Values can be stale when Windows stops reporting."
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homeaway-vm"
          },
          "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(sensordash_sensor_info_value{host=~\"$host\"} == 1, \"name\", \"$1 $2\", \"name\", \"^(.*)_(.*)$\"), \"name\", \"$1 $2\", \"name\", \"^(.*)_(.*)$\"), \"name\", \"$1 $2\", \"name\", \"^(.*)_(.*)$\"), \"name\", \"$1 $2\", \"name\", \"^(.*)_(.*)$\"), \"name\", \"$1 $2\", \"name\", \"^(.*)_(.*)$\"), \"name\", \"$1 $2\", \"name\", \"^(.*)_(.*)$\"), \"alias\", \"$1 $2\", \"alias\", \"^(.*)_(.*)$\"), \"alias\", \"$1 $2\", \"alias\", \"^(.*)_(.*)$\"), \"alias\", \"$1 $2\", \"alias\", \"^(.*)_(.*)$\"), \"alias\", \"$1 $2\", \"alias\", \"^(.*)_(.*)$\"), \"alias\", \"$1 $2\", \"alias\", \"^(.*)_(.*)$\"), \"alias\", \"$1 $2\", \"alias\", \"^(.*)_(.*)$\"), \"device\", \"$1 $2\", \"device\", \"^(.*)_(.*)$\"), \"device\", \"$1 $2\", \"device\", \"^(.*)_(.*)$\"), \"device\", \"$1 $2\", \"device\", \"^(.*)_(.*)$\"), \"device\", \"$1 $2\", \"device\", \"^(.*)_(.*)$\"), \"device\", \"$1 $2\", \"device\", \"^(.*)_(.*)$\"), \"device\", \"$1 $2\", \"device\", \"^(.*)_(.*)$\")",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "sensor": true,
              "Value": true,
              "Value #A": true
            },
            "indexByName": {
              "device": 0,
              "name": 1,
              "alias": 2,
              "kind": 3,
              "host": 4
            },
            "renameByName": {
              "device": "Device",
              "name": "Sensor",
              "alias": "Alias",
              "kind": "Type",
              "host": "Computer"
            }
          }
        }
      ]
    },
