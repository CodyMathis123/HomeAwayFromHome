    {
      "id": 111,
      "title": "Latest temperature",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "description": "The highlighted Stat value is the maximum observed temperature with its winning sensor name derived from this *same* query response; sensor aliases take precedence and raw underscores are normalized for display. Latest available reported reading may be stale when the PC stops reporting.The name and value update atomically on panel refresh and cannot disagree due to hidden dashboard variables.",
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "fixed",
            "fixedColor": "#FFB454"
          },
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "textSize": {
              "titleSize": 12,
              "valueSize": 45
            }
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "vertical",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homeaway-vm"
          },
          "expr": "label_transform(label_transform((topk(1, sensordash_reading_value{host=~\"$host\",sensor=~\"$sensor\",kind=\"Temperature\"} * on(host,sensor) group_left() (sensordash_sensor_info_value{host=~\"$host\",name!~\"(?i).*(warning|critical).*\"} == 1)) * on(host,sensor) group_left(name) (label_replace((sensordash_sensor_info_value{host=~\"$host\",name!~\"(?i).*(warning|critical).*\",alias!=\"unassigned\"} == 1), \"name\", \"$1\", \"alias\", \"(.+)\") or (sensordash_sensor_info_value{host=~\"$host\",name!~\"(?i).*(warning|critical).*\",alias=\"unassigned\"} == 1))), \"name\", \"_+\", \" \"), \"name\", \"^ +| +$\", \"\")",
          "instant": true,
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 112,
      "title": "Peak temperature · selected range",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "description": "The highlighted Stat value is the maximum observed temperature with its winning sensor name derived from this *same* query response; sensor aliases take precedence and raw underscores are normalized for display. A range maximum can come from a different probe than the latest available temperature. The name and value update atomically on panel refresh and cannot disagree due to hidden dashboard variables.",
