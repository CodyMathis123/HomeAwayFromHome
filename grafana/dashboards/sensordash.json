      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "spanNulls": false,
            "showPoints": "never",
            "lineWidth": 2,
            "fillOpacity": 14,
            "axisBorderShow": false
