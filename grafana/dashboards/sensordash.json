{
  "id": null,
  "uid": "homeaway-sensordash",
  "title": "SensorDash · Hardware Telemetry",
  "tags": [
    "homeaway",
    "sensordash",
    "read-only"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "10s",
  "editable": false,
  "graphTooltip": 1,
  "description": "Raw readings exported asynchronously from Windows SQLite history. No remote fan control. Missing data is not joined across outages. Sensor names/aliases are descriptive metadata, not part of raw sensor identity.",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Windows computer",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homeaway-vm"
        },
        "query": {
          "query": "label_values(sensordash_reading_value,host)",
          "refId": "Host"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "sensor",
        "label": "Sensor IDs",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homeaway-vm"
        },
        "query": {
          "query": "label_values(sensordash_reading_value{host=~\"$host\"},sensor)",
          "refId": "Sensor"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "title": "Sensor catalog and aliases",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "description": "Latest SensorDash sensor names, aliases, types and devices. Identity remains a stable hardware sensor ID; alias changes do not fragment raw measurements. Metadata refreshes every two minutes.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homeaway-vm"
          },
          "expr": "sensordash_sensor_info_value{host=~\"$host\"} == 1",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 1,
      "title": "Temperatures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homeaway-vm"
          },
          "expr": "sensordash_reading_value{host=~\"$host\",sensor=~\"$sensor\",kind=\"Temperature\"}",
          "legendFormat": "{{host}} · {{sensor}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Fan / pump tachometers",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rpm",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
