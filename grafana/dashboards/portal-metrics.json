    {
      "id": 9,
      "title": "Temperature history · PC and coolant",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "description": "Real temperature readings only. Sleep/resume gaps remain gaps; no hidden interpolation. Also includes high flow NEXT coolant temperature and optional external thermistor, discovered by physical sensor metadata; absent probe values yield no series.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homeaway-vm"
          },
          "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(sensordash_reading_value{host=~\".+\",kind=\"Temperature\",sensor=~\".*(cpu|gpu|nvme|storage|hdd|ssd).*/temperature/.*\"} * on(host,sensor) group_left(name,alias,device) (label_replace(sensordash_sensor_info_value{host=~\".+\",name!~\"(?i).*(warning|critical).*\",alias!=\"unassigned\"} == 1, \"name\", \"$1\", \"alias\", \"(.+)\") or (sensordash_sensor_info_value{host=~\".+\",name!~\"(?i).*(warning|critical).*\",alias=\"unassigned\"} == 1)), \"name\", \"$1 $2\", \"name\", \"^(.*)_(.*)$\"), \"name\", \"$1 $2\", \"name\", \"^(.*)_(.*)$\"), \"name\", \"$1 $2\", \"name\", \"^(.*)_(.*)$\"), \"name\", \"$1 $2\", \"name\", \"^(.*)_(.*)$\"), \"device\", \"$1 $2\", \"device\", \"^(.*)_(.*)$\"), \"device\", \"$1 $2\", \"device\", \"^(.*)_(.*)$\"), \"device\", \"$1 $2\", \"device\", \"^(.*)_(.*)$\")",
          "range": true,
          "legendFormat": "{{device}} · {{name}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "homeaway-vm"
          },
          "range": true,
          "legendFormat": "{{device}} · {{name}}",
          "expr": "sensordash_reading_value{host=~\".+\",kind=\"Temperature\"} * on(host,sensor) group_left(name,device) (sensordash_sensor_info_value{host=~\".+\",device=\"high_flow_NEXT\",kind=\"Temperature\",name=\"Water_Temperature\"} == 1)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "homeaway-vm"
          },
          "range": true,
          "legendFormat": "{{device}} · {{name}}",
          "expr": "sensordash_reading_value{host=~\".+\",kind=\"Temperature\"} * on(host,sensor) group_left(name,device) (sensordash_sensor_info_value{host=~\".+\",device=\"high_flow_NEXT\",kind=\"Temperature\",name=\"External_Temperature\"} == 1)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "/_/g",
            "renamePattern": " "
          }
        }
      ]
    },
