{
  "id": null,
  "uid": "homeaway-portal",
  "title": "HomeAway · Portal Metrics",
  "tags": [
    "homeaway",
    "portal",
    "read-only",
    "embedded"
  ],
  "description": "Compact shared dashboard for LAN/VPN HomeAway iframe. No template variables or control APIs. All Windows hosts are included (max values on summary tiles). Compact read-only metrics for the Portal's Grafana embed; intentionally repeats small summaries but is not intended to be the primary diagnostic dashboard. Includes live high flow NEXT coolant temperature (°C) and circulation (L/h) panels, matched by device/name/type catalog metadata rather than USB sensor paths.",
  "schemaVersion": 40,
  "version": 2,
  "editable": false,
  "timezone": "browser",
  "graphTooltip": 0,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU temperature",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "description": "Highest CPU temperature from sensors currently exported; may be hotspot rather than package temperature.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homeaway-vm"
          },
          "expr": "max(sensordash_reading_value{host=~\".+\",kind=\"Temperature\",sensor=~\".*cpu.*/temperature/.*\"})",
          "range": true,
          "legendFormat": "CPU temperature"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "—",
          "color": {
            "mode": "fixed",
            "fixedColor": "#62d5ce"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
