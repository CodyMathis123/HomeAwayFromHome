    {
      "id": 11,
      "title": "Coolant temperature",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "description": "Actual high flow NEXT coolant temperature from the SensorDash USB sensor catalog. Latest reported value across Windows hosts; missing/stale readings show no data. The small shaded trace is the observed history over the dashboard period, not a synthetic curve.",
