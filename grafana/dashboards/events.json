        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "### EVENT TIMELINE\nBars represent isolated events at their actual occurrence times. No interpolation across events or Windows sleep gaps."
      }
    },
    {
      "id": 4,
      "title": "Warnings",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "description": "Each isolated sample indicates a threshold crossing; no free-form messages or original user paths are copied.",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homeaway-vm"
          },
          "expr": "sensordash_event_value{host=~\"$host\",severity=\"warning\"}",
          "range": true,
          "legendFormat": "{{sensor}} · warning"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 40,
            "showPoints": "always",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic-by-name"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "/_/g",
            "renamePattern": " "
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Recoveries",
      "type": "timeseries",
      "datasource": {
