{
  "id": null,
  "uid": "homeaway-events",
  "title": "SensorDash · Events",
  "tags": [
    "homeaway",
    "sensordash",
    "read-only"
  ],
  "description": "Read-only timeline of Windows SensorDash threshold crossings and recoveries. Full messages, sensor association editing, and threshold settings remain local to Windows. Each event is sent once at its original timestamp; no raw event message or remote control is exported.",
  "schemaVersion": 40,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Other HomeAway views",
      "tags": [
        "homeaway"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Windows computer",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homeaway-vm"
        },
        "query": {
          "query": "label_values(sensordash_reading_value,host)",
          "refId": "Host"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 100,
      "title": "",
      "type": "text",
      "transparent": true,
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "targets": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "### WINDOWS · SENSOR EVENTS\nThreshold crossings and recoveries copied from the local event archive. A missing time period means no exported events, not zero alert risk."
      }
    },
    {
      "id": 1,
      "title": "Events · selected range",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "description": "Count of persisted threshold-event samples in the Grafana time window.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homeaway-vm"
          },
          "expr": "sum(count_over_time(sensordash_event_value{host=~\"$host\"}[$__range])) or vector(0)",
          "instant": true,
          "legendFormat": "Events · selected range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "—",
          "color": {
            "mode": "fixed",
            "fixedColor": "#62d5ce"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto",
        "textMode": "auto"
      }
    },
    {
