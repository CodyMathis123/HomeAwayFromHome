    {
      "id": 101,
      "type": "text",
      "title": "",
      "transparent": true,
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "targets": [],
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "### COOLING · SEPARATE HARDWARE ROLES\nRadiator fan-group and fixed-speed DDC pump readings are shown separately using the cooling bindings configured in SensorDash. NVMe fan readings are **not** mixed in. Tachometer RPM is actual feedback; PWM duty is not proof of physical speed."
      }
    },
    {
      "id": 9,
      "title": "Radiator fan group · peak RPM",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "description": "Peak observed radiator fan tachometer reading from SensorDash cooling bindings; NVMe and other unrelated fans are excluded. Does not infer the speed of individual fans on the shared hub.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homeaway-vm"
          },
          "expr": "max(max_over_time(sensordash_reading_value{host=~\"$host\",kind=\"Fan\"}[$__range]) * on(host,sensor) group_right() (sensordash_cooling_binding_value{host=~\"$host\",kind=\"Fan\",role=\"fan-group\"} == 1))",
          "range": true,
          "legendFormat": "Radiator fan group · peak RPM"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rotrpm",
          "noValue": "—",
          "color": {
            "mode": "fixed",
            "fixedColor": "#62d5ce"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
