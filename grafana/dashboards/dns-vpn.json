      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "description": "Pi-hole's current queries/second gauge. It may show zero when DNS is quiet even while the rolling reporting window contains previous queries.",
