        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homeaway-vm"
          },
          "expr": "homeaway_pihole_query_frequency",
          "legendFormat": "DNS queries/s",
          "range": true
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "/_/g",
            "renamePattern": " "
          }
        }
      ]
