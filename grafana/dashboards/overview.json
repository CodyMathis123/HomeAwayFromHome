        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homeaway-vm"
          },
          "expr": "time() - max(timestamp(sensordash_reading_value{host=~\"$host\"}[24h]))",
          "legendFormat": "Windows telemetry · sample age",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No samples in 24h",
          "color": {
