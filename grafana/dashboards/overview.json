    {
      "id": 9,
      "title": "Windows telemetry · sample age",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "description": "Seconds since the newest raw SensorDash measurement from the selected Windows host in the preceding 24 hours. A large value means the stream is old; sleep, shutdown, network failure and exporter failure cannot be distinguished by this signal alone. An empty result means no samples in 24 hours, not zero seconds. This uses VictoriaMetrics' MetricsQL timestamp(range) operator.",
      "gridPos": {
        "x": 15,
        "y": 38,
        "w": 9,
        "h": 4
      },
