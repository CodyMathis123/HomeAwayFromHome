  "title": "SensorDash · Overview",
  "tags": [
    "homeaway",
    "sensordash",
    "read-only",
    "overview",
    "everyday"
  ],
  "description": "SensorDash read-only overview: distinct latest hottest CPU/GPU readings with aggregate history, plus peak values with an individually selected winning physical sensor, alias-first labels, and sparkline; cooling/energy/sensor inventory. CPU total/max-core and GPU core/memory activity trends now align with temperatures and power for workload context; only physical, exported Load sensors are used.",
  "schemaVersion": 40,
  "version": 13,
  "editable": false,
  "timezone": "browser",
  "graphTooltip": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "datasource": {
    "type": "prometheus",
    "uid": "homeaway-vm"
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Other HomeAway views",
      "tags": [
        "homeaway"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "dashboard",
      "tooltip": "Jump to other HomeAway monitoring views"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Windows computer",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homeaway-vm"
        },
        "query": {
          "query": "label_values(sensordash_reading_value,host)",
          "refId": "Host"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "",
      "transparent": true,
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "targets": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "### HIGHEST REPORTED TEMPERATURE · LATEST AVAILABLE\nCPU/GPU cards show the hottest *latest-available* sensor reading, not a peak over the selected history. A value can be stale if Windows sleeps or stops exporting; the sparklines show observed readings, not uninterrupted uptime."
      }
    },
    {
      "id": 1,
      "title": "CPU · highest reported temperature",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "description": "Latest available reported temperature across CPU sensors, taking the highest at each observation; the sparkline is that maximum over time. This is not a fixed package/core/hotspot sensor and does not prove the PC is currently online. For individual sensor names, open the Live hardware readings detail table below. Offline gaps are not filled.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homeaway-vm"
          },
          "expr": "max(sensordash_reading_value{host=~\"$host\",kind=\"Temperature\"} * on(host,sensor) group_left(device,name) (sensordash_sensor_info_value{host=~\"$host\",device_type=\"Cpu\",kind=\"Temperature\",name!~\"(?i).*(warning|critical).*\"} == 1))",
          "range": true,
          "legendFormat": "CPU · highest reported temperature"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "—",
          "color": {
            "mode": "fixed",
            "fixedColor": "#62d5ce"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
