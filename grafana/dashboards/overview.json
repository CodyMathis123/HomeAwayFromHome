{
  "id": null,
  "uid": "homeaway-overview",
  "title": "SensorDash · Overview",
  "tags": [
    "homeaway",
    "sensordash",
    "read-only",
    "overview"
  ],
  "description": "A SensorDash-inspired, read-only front page with featured sensor cards, sample-based peaks, CPU/GPU power, cooling electrical estimates, temperature history, and catalog summaries. Actual fan control, aliases, configured probes, energy integrals and retention remain authoritative on the Windows collector.",
  "schemaVersion": 40,
  "version": 3,
  "editable": false,
  "timezone": "browser",
  "graphTooltip": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "datasource": {
    "type": "prometheus",
    "uid": "homeaway-vm"
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Other HomeAway views",
      "tags": [
        "homeaway"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "dashboard",
      "tooltip": "Jump to other HomeAway monitoring views"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Windows computer",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homeaway-vm"
        },
        "query": {
          "query": "label_values(sensordash_reading_value,host)",
          "refId": "Host"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
