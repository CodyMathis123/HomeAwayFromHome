      "title": "Local history buffer",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "description": "SQLite database plus WAL/SHM file sizes on Windows; retained as a bounded retry buffer.",
      "gridPos": {
        "x": 12,
