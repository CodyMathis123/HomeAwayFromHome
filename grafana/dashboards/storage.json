{
  "id": null,
  "uid": "homeaway-storage",
  "title": "SensorDash · Drives & Retention",
  "tags": [
    "homeaway",
    "sensordash",
    "read-only",
    "hardware"
  ],
  "description": "Windows drive health and SensorDash retry spool up front; Pi-side VictoriaMetrics capacity, series counts, and long-term history analysis are an expandable advanced section. Read-only.",
  "schemaVersion": 40,
  "version": 4,
  "editable": false,
  "timezone": "browser",
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Other HomeAway views",
      "tags": [
        "homeaway"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Windows computer",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homeaway-vm"
        },
        "query": {
          "query": "label_values(sensordash_reading_value,host)",
          "refId": "Host"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 100,
      "title": "",
      "type": "text",
      "transparent": true,
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "targets": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "### WINDOWS STORAGE · SSD/NVMe\nLive temperatures, utilization and drive signals from SensorDash. Missing hardware sensors are left missing; fixed warning/critical temperature specifications are excluded from live heat graphs."
      }
    },
    {
      "id": 1,
      "title": "Detected storage devices",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "description": "Count of storage devices with exported sensor metadata.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homeaway-vm"
          },
          "expr": "count(count by (host,device) (sensordash_sensor_info_value{host=~\"$host\",device_type=\"Storage\"} == 1))",
          "instant": true,
          "legendFormat": "Detected storage devices"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "—",
          "color": {
            "mode": "fixed",
            "fixedColor": "#62d5ce"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Highest drive temperature",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "description": "Highest current storage temperature; no fabricated fallback if this device has no temperature sensor.",
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homeaway-vm"
          },
          "expr": "max(sensordash_reading_value{host=~\"$host\",kind=\"Temperature\"} * on(host,sensor) group_left(name,device,device_type) (sensordash_sensor_info_value{host=~\"$host\",device_type=\"Storage\",name!~\"(?i).*(warning|critical).*\"} == 1))",
          "instant": true,
          "legendFormat": "Highest drive temperature"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "—",
          "color": {
            "mode": "fixed",
            "fixedColor": "#f2bd6d"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto",
        "textMode": "auto"
      }
    },
    {
