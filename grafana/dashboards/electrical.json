          "expr": "label_replace((sensordash_accessory_power_value{host=~\"$host\",system=~\"$system\",source=\"measured\"} * on(host,system,component) group_left(component_name,system_name,role) (sensordash_component_info_value{host=~\"$host\",system=~\"$system\"} == 1)), \"revision_short\", \"$1\", \"revision\", \"^([0-9a-f]{6})[0-9a-f]{10}$\")",
          "legendFormat": "{{component_name}} · {{source}} · rev {{revision_short}}",
