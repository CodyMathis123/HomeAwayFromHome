            "uid": "homeaway-vm"
          },
          "expr": "sensordash_accessory_power_value{host=~\"$host\",system=~\"$system\",source=~\"$source\"} * on(host,system,component) group_left(component_name,system_name,role) (sensordash_component_info_value{host=~\"$host\",system=~\"$system\",role=\"pump\"} == 1)",
          "legendFormat": "{{component_name}} · {{source}} · rev {{revision}}",
          "range": true
