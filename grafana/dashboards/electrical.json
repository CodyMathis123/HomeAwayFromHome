          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homeaway-vm"
          },
          "expr": "sensordash_accessory_power_value{host=~\"$host\",system=~\"$system\",source=\"measured\"} * on(host,system,component) group_left(component_name,system_name,role) (sensordash_component_info_value{host=~\"$host\",system=~\"$system\"} == 1)",
          "legendFormat": "{{component_name}} · {{source}} · rev {{revision}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Pump electrical estimates",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 9
      },
      "description": "Archived watts from SensorDash's C# electrical model. The source label distinguishes real measurements, user calibration, curves and nameplate-rated estimates; config revision preserves the historical model.",
      "fieldConfig": {
        "defaults": {
