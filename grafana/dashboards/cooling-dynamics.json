{
  "id": null,
  "uid": "homeaway-cooling-dynamics",
  "title": "SensorDash · Cooling Dynamics",
  "schemaVersion": 40,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "graphTooltip": 1,
  "description": "Read-only, correlated thermal analysis. Current means a measured sample within the past two minutes; historical curves use the selected time range. No missing data is replaced with zero. Optional high flow NEXT external probe must be positioned at radiator intake to represent intake air.",
  "tags": [
    "homeaway",
    "sensordash",
    "cooling",
    "analysis",
    "read-only"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Windows PC",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homeaway-vm"
        },
        "query": {
          "query": "label_values(sensordash_reading_value,host)",
          "refId": "A"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "",
      "type": "text",
      "transparent": true,
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "targets": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "## COOLING DYNAMICS · current condition\n**Current** = last real sample within 2 minutes, *not* a peak or selected-period average. An em dash means absent or stale. **Trends below** use the dashboard time range; hover at one timestamp to compare power, coolant and fans. All data is read-only."
      }
    },
    {
      "id": 1,
      "title": "Coolant · now",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "description": "Measured NEXT water temperature, in °C.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "fixed",
            "fixedColor": "#72BBE8"
          },
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "textSize": {
              "titleSize": 12,
              "valueSize": 36
            }
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "vertical",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "wideLayout": false,
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "homeaway-vm"
          },
          "expr": "max by(host) (last_over_time(sensordash_reading_value{host=~\"$host\",kind=\"Temperature\"}[2m]) * on(host,sensor) group_left() (sensordash_sensor_info_value{host=~\"$host\",device=\"high_flow_NEXT\",kind=\"Temperature\",name=\"Water_Temperature\"} == 1))",
          "legendFormat": "{{host}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
