{
  "id": null,
  "uid": "homeaway-cooling",
  "title": "SensorDash · Cooling Systems",
  "schemaVersion": 40,
  "version": 2,
  "editable": false,
  "timezone": "browser",
  "graphTooltip": 1,
  "description": "Windows-owned cooling system mappings, visualized in Grafana. Associations only exist after metadata synchronization begins; no remote hardware control.",
  "tags": [
    "homeaway",
    "sensordash",
    "cooling",
    "read-only"
  ],
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Windows PC",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homeaway-vm"
        },
        "query": {
          "query": "label_values(sensordash_reading_value,host)",
          "refId": "A"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "system",
        "label": "Cooling system",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homeaway-vm"
        },
        "query": {
          "query": "label_values(sensordash_cooling_binding_value{host=~\"$host\"},system)",
          "refId": "A"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Cooling sensor assignments",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "description": "Current read-only assignments from SensorDash. Sensor names and aliases come from its sensor catalog; raw hardware IDs are hidden only in this table. This is metadata, not proof that every assigned sensor has recent measurements.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homeaway-vm"
          },
          "expr": "(sensordash_cooling_binding_value{host=~\"$host\",system=~\"$system\"} == 1) * on(host,sensor) group_left(name,alias,device) (sensordash_sensor_info_value{host=~\"$host\"} == 1)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "component": true,
              "system": true,
              "sensor": true,
              "Value": true,
              "Value #A": true,
              "device": true
            },
            "indexByName": {
              "component_name": 0,
              "role": 1,
              "name": 2,
              "alias": 3,
              "kind": 4,
              "system_name": 5,
              "host": 6
            },
            "renameByName": {
              "component_name": "Component",
              "role": "Role",
              "name": "Sensor",
              "alias": "Alias",
              "kind": "Reading type",
              "system_name": "Cooling system",
              "host": "Computer"
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Assigned temperatures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "description": "Measurements are recorded on Windows; cooling assignments remain controlled by SensorDash. Gaps are not filled. Series names come from the SensorDash sensor catalog; stable sensor IDs and the raw measurement values are unchanged. Alias/label changes do not rewrite archived samples.",
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homeaway-vm"
          },
          "expr": "(sensordash_reading_value{host=~\"$host\",kind=\"Temperature\"} * on(host,sensor) group_right() (sensordash_cooling_binding_value{host=~\"$host\",system=~\"$system\",kind=\"Temperature\"} == 1)) * on(host,sensor) group_left(name,alias,device) (sensordash_sensor_info_value{host=~\"$host\"} == 1)",
          "legendFormat": "{{component_name}} · {{name}}",
          "range": true
        }
      ]
    },
