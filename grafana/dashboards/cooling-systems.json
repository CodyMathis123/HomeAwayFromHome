    {
      "id": 2,
      "title": "Assigned temperatures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 9
      },
      "description": "Measurements are recorded on Windows; cooling assignments remain controlled by SensorDash. Gaps are not filled. Series names come from the SensorDash sensor catalog; stable sensor IDs and the raw measurement values are unchanged. Alias/label changes do not rewrite archived samples. Visible name labels are normalized at query time; the stored series and join identity labels are unchanged.",
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "spanNulls": false,
            "showPoints": "never",
            "lineWidth": 2,
            "fillOpacity": 14,
            "axisBorderShow": false
          },
          "color": {
            "mode": "palette-classic-by-name"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
