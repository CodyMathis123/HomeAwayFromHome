        "h": 9
      },
      "description": "Measurements are recorded on Windows; cooling assignments remain controlled by SensorDash. Gaps are not filled.",
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
