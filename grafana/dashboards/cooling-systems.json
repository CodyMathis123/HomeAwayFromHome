{
  "id": null,
  "uid": "homeaway-cooling",
  "title": "SensorDash · Cooling Systems",
  "schemaVersion": 40,
  "version": 5,
  "editable": false,
  "timezone": "browser",
  "graphTooltip": 1,
  "description": "Windows-owned cooling system mappings, visualized in Grafana. Associations only exist after metadata synchronization begins; no remote hardware control.",
  "tags": [
    "homeaway",
    "sensordash",
    "cooling",
    "read-only"
  ],
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Windows PC",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homeaway-vm"
        },
        "query": {
          "query": "label_values(sensordash_reading_value,host)",
          "refId": "A"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "system",
        "label": "Cooling system",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homeaway-vm"
        },
        "query": {
          "query": "label_values(sensordash_cooling_binding_value{host=~\"$host\"},system)",
          "refId": "A"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
