{
  "id": null,
  "uid": "homeaway-system",
  "title": "HomeAway · System Health",
  "tags": [
    "homeaway",
    "read-only",
    "pi",
    "monitoring",
    "everyday"
  ],
  "description": "Pi 4 host metrics from a minimal internal Node Exporter; VictoriaMetrics data-store health; DNS/VPN scrape availability; and actual Windows sensor-sample freshness. No control or remote administration. Pi resource and scrape health; the Windows sample-age tile is only observed reporting freshness, not proof of an actual cooling or Windows fault.",
  "schemaVersion": 40,
  "version": 3,
  "editable": false,
  "timezone": "browser",
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Other HomeAway views",
      "tags": [
        "homeaway"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "dashboard",
      "tooltip": "Jump to other HomeAway monitoring views"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Windows computer",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homeaway-vm"
        },
        "query": {
          "query": "label_values(sensordash_reading_value,host)",
          "refId": "Host"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
