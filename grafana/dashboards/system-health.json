    {
      "id": 1,
      "title": "Pi CPU activity",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "homeaway-vm"
      },
      "description": "Five-minute busy CPU ratio across host cores. Not a container CPU quota.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "homeaway-vm"
          },
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"pi-node\",mode=\"idle\"}[5m])))",
          "instant": true,
          "legendFormat": "Pi CPU activity"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "—",
          "color": {
            "mode": "fixed",
            "fixedColor": "#62d5ce"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
