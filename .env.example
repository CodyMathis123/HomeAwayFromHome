# Copy to .env and customize for YOUR Pi and network.
# Bind addresses deliberately restrict DNS and browser UIs to the Pi's LAN IPv4.
PI_LAN_IP=192.168.1.10
LAN_CIDR=192.168.1.0/24
TZ=America/Detroit
# Hostname you own, DNS A/AAAA points at your home WAN IP; router forwards UDP 51820.
VPN_ENDPOINT=vpn.example.com
VPN_PORT=51820
# Distinct from your home LAN and the Docker bridge subnet.
# Documentation/preflight value only. In wg-easy v15, configure the actual
# tunnel range in the UI; default observed on first run was 10.8.0.0/24.
VPN_CIDR=10.8.0.0/24
# Pi-hole v6 array syntax: semicolon-separated.
UPSTREAM_DNS=1.1.1.1;9.9.9.9
